{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climbhill.ai/schemas/okf-concept.schema.json",
  "title": "OKF v0.2 Concept Frontmatter",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "resource": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "object", "required": ["resource"], "additionalProperties": true } }
  },
  "additionalProperties": true
}
