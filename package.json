{
  "name": "climbhill",
  "version": "0.2.0-alpha.0",
  "description": "Local-first agentic workflow research and improvement CLI",
  "type": "commonjs",
  "bin": {
    "climbhill": "dist/npm/cli.js"
  },
  "files": [
    "dist/npm",
    "baml_src",
    ".agent/skills"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-tests/tests-ts/*.test.js",
    "clean": "rm -rf dist dist-tests",
    "baml:generate": "baml-cli generate --from ./baml_src",
    "baml:check": "npm run baml:generate && git diff --exit-code -- src/baml_client climbhill/baml_client",
    "okf:spec": "node scripts/verify-okf.cjs",
    "dogfood": "npm run build && node scripts/dogfood.cjs",
    "www:build": "npm --prefix www run build"
  },
  "dependencies": {
    "@boundaryml/baml": "0.226.1",
    "yaml": "2.9.0",
    "youtube-transcript": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/closedloop-technologies/climbhill.git"
  }
}
